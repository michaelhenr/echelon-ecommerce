# Environment Configuration for Echelon Ecommerce

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/echelon_ecommerce

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2025
JWT_EXPIRE=7d

# Security Configuration
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@echelon.com
ADMIN_PASSWORD=admin123

# Email Configuration (for future implementation)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Payment Gateway Configuration (for future implementation)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
